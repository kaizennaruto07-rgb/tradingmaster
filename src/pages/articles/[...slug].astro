<Layout
  title={`${article.data.title} · Monks Of Market`}
  description={description}
  current="articles"
  schema={schemaHtml}
  ogType="article"
>
  <article class="article-page">
    <div class="shell">
      <div class="tool-header">
        <div class="eyebrow">Monks Of Market · Article</div>
        <h1>{article.data.title}</h1>
        <p class="tool-lead">{description}</p>
        <div class="article-card-meta">
          <span>By {article.data.author}</span>
          <span>{dateStr}</span>
        </div>
      </div>
      <div class="article-body">
        <Content />
      </div>
      <EmailSignup
        variant="article"
        formId="9999729"
        uid="8b81f75b9e"
        heading="Get the next breakdown first"
        subtext="One exceptional article per day. No spam, unsubscribe anytime."
      />
      <div class="article-cta">
        <a class="btn btn-primary" href={toolCta.href}>{toolCta.label} <span>→</span></a>
