---
interface Props {
  current?: string;
}
const { current = '' } = Astro.props;
---
<header class="topline" id="topline">
  <div class="scroll-meter" aria-hidden="true"></div>
  <div class="shell topline-inner">
    <div class="status"><i class="pulse"></i><a class="wordmark home-anchor" href="/">Monks Of Market</a><span class="status-meta">Locked fee model · Oct 2026</span></div>
    <nav class="top-nav" aria-label="Primary">
      <a class="nav-link" href="/" aria-current={current === 'home' ? 'page' : undefined}>Home</a>
      <a class="nav-link nav-always" href="/articles/" aria-current={current === 'articles' ? 'page' : undefined}>Articles</a>
      <div class="nav-item" id="toolsNavItem">
        <button class="nav-drop" id="toolsMenuBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-current={current === 'tools' ? 'page' : undefined}>Tools ▾</button>
        <div class="menu-panel" id="toolsMenu" role="menu">
          <a role="menuitem" href="/tools/crypto-futures/"><span>Crypto futures</span><small>USDT position costs · Delta Exchange</small><em>→</em></a>
          <a role="menuitem" href="/tools/options-cost/"><span>Indian equity options</span><small>Full-cost NSE / BSE calculations</small><em>→</em></a>
          <a role="menuitem" href="/tools/what-if-simulator/"><span>What-If Trade Simulator</span><small>Monte Carlo strategy simulation</small><em>→</em></a>
          <div class="menu-divider"></div>
          <a role="menuitem" href="/tools/"><span>All tools</span><small>Browse the toolbox</small><em>→</em></a>
        </div>
      </div>
    </nav>
    <div class="top-actions"><button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch to light mode"><svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button><a class="mini-btn" href="/tools/">Explore tools ↓</a></div>
  </div>
</header>
